# Valeurs par défaut de l'application et de ses skills, transmises au service
# "api" (voir compose.yaml). Ne pas modifier ici : surcharger dans .env, qui
# est prioritaire (voir .env.example).
#
# Ajouter un skill : documenter ici ses variables avec leur valeur par défaut.
# compose.yaml et run.sh ne changent pas.

# --- Application (app/) --------------------------------------------------------
# Skills enregistrés, séparés par des virgules. Vide = tous les skills
# disponibles (voir app/app.go).
SKILLS=
# Skills actifs dès l'ouverture d'une session : le modèle n'a pas à les
# activer lui-même, ce qui économise un appel par conversation. Vide = le
# modèle active le skill qui correspond à la demande.
ACTIVE_SKILLS=
# Appels au modèle par message : une recherche de prospects enchaîne de
# nombreuses recherches et lectures de pages.
AGENT_MAX_STEPS=30

# --- Skill prise-de-rendez-vous -----------------------------------------------
# Fuseau des horaires d'ouverture du calendrier de démonstration
# (l'interface utilise le fuseau du navigateur pour l'utilisateur).
CALENDAR_TZ=Europe/Paris
# Politique produit : réserver directement un créneau unique.
AUTO_BOOKING=false

# --- Skill prospect-research --------------------------------------------------
# Instance SearXNG utilisée par web_search (service searxng de compose.yaml).
# Les pages lues par web_fetch le sont directement, en HTTP, depuis l'API.
SEARXNG_URL=http://searxng:8080

# --- Skill agenda ---------------------------------------------------------------
# Aucune configuration : agenda en mémoire (agenda.MockProvider), propre à
# chaque utilisateur, vidé au redémarrage. Voir skills/agenda/SKILL.md.

# --- Skill synthese-vocale ----------------------------------------------------
# Moteur de synthèse vocale : kokoro (service kokoro de compose.yaml).
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://kokoro:8880
# Audio transmis phrase par phrase, au fil de la génération.
TTS_STREAMING=true
# Voix proposées, par langue : langue=voix1,voix2;langue2=…  La première voix
# d'une langue est sa voix par défaut. Voix de Kokoro : préfixe f = français,
# a = anglais américain, b = britannique, e = espagnol, i = italien…
# (liste complète : GET http://kokoro:8880/v1/audio/voices).
TTS_VOICES=fr-FR=ff_siwis;en-US=af_heart,af_bella,am_michael;en-GB=bf_emma,bm_george
TTS_DEFAULT_LANGUAGE=fr-FR
# mp3 (lu par tous les navigateurs), opus ou wav.
TTS_DEFAULT_FORMAT=mp3
TTS_DEFAULT_SPEED=1.0
TTS_MIN_SPEED=0.5
TTS_MAX_SPEED=2.0
# Caractères par lecture : le modèle découpe un texte plus long.
TTS_MAX_TEXT_LENGTH=2000
# Durée maximale d'une synthèse, lecture du flux comprise.
TTS_TIMEOUT=2m
# Synthèses simultanées (sur CPU, chacune occupe le processeur) ; les
# suivantes attendent leur tour.
TTS_MAX_CONCURRENT=2
