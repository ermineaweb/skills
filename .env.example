# Configuration facultative : copier en .env pour changer les valeurs par défaut.

# --- Modèle en ligne (API compatible OpenAI) ---------------------------------
# Si MODEL_BASE_URL est défini, ce modèle est utilisé et Ollama n'est pas lancé.
# Le modèle doit gérer l'appel d'outils (function calling).
#
# Google Gemini (gratuit, clé : https://aistudio.google.com/apikey)
#   Les quotas gratuits sont faibles (quelques requêtes/minute, quelques
#   dizaines à centaines/jour) et chaque message peut faire plusieurs appels.
#   Les données du niveau gratuit peuvent servir à améliorer les produits Google.
#   Modèles (les anciens sont retirés régulièrement ; liste : GET
#   $MODEL_BASE_URL/models) : gemini-3.5-flash-lite (rapide, plus de quota),
#   gemini-3.8-flash (plus capable), ou les alias gemini-flash-lite-latest /
#   gemini-flash-latest qui suivent la dernière version.
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_API_KEY=
# MODEL=gemini-3.5-flash-lite
#
# Groq (gratuit, clé : https://console.groq.com/keys)
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_API_KEY=
# MODEL=<modèle gérant les tools, voir https://console.groq.com/docs/models>
#
# OpenRouter (modèles suffixés « :free », clé : https://openrouter.ai/keys)
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_API_KEY=
# MODEL=<modèle>:free
#
# Inutile en ligne : le préchauffage consommerait une requête de quota.
# MODEL_WARMUP=false
# MODEL_TIMEOUT=2m
# Quota par minute dépassé (HTTP 429) : l'appel est retenté après le délai
# indiqué par l'API, dans la limite de cette attente par appel (0s : jamais).
# MODEL_RATE_LIMIT_WAIT=2m

# --- Modèle local (Ollama, utilisé si MODEL_BASE_URL est vide) ---------------
# Préférer une variante « instruct » : les modèles à réflexion (ex: qwen3:4b)
# génèrent des centaines de tokens avant chaque réponse, ce qui est très lent
# sur CPU.
#   qwen3:4b-instruct  ~2,5 Go (défaut, adapté à 8 Go de RAM sans GPU)
#   qwen2.5:7b         ~4,7 Go (nécessite plus de RAM)
#   qwen2.5:3b         ~2 Go (plus rapide, moins fiable)
# MODEL=qwen3:4b-instruct
# MODEL_EXTRA_BODY={"temperature":0.7}
# MODEL_TIMEOUT=10m
# MODEL_CONTEXT=8192

# --- Skills ------------------------------------------------------------------
# Les valeurs par défaut de l'application et de chaque skill sont dans
# app.env. Pour en changer une, la recopier ici : .env est prioritaire et
# toutes ses variables sont transmises à l'API. Exemples :
# SKILLS=prospect-research
# ACTIVE_SKILLS=prise-de-rendez-vous
# TTS_DEFAULT_FORMAT=opus
# TTS_VOICES=fr-FR=ff_siwis;en-US=af_heart
# SEARXNG_URL=https://searx.example.org   # autre instance SearXNG (format json activé)
#
# Le skill prospect-research a des instructions longues et enchaîne de
# nombreux appels : préférer un modèle en ligne (le contexte du modèle local
# par défaut, 8192 tokens, ne suffit pas) et, avec un quota gratuit, compter
# plusieurs minutes par recherche (erreur 429 possible).

# --- Divers -------------------------------------------------------------------

# Port de l'interface sur la machine hôte.
WEB_PORT=8080
